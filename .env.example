# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional. Multi-model routing (Claude, DeepSeek, Llama 3, Qwen) for AI Assistant.
OPENROUTER_API_KEY=""

# MISTRAL_API_KEY: Optional. Mistral Large / Codestral for code analysis & prompt optimization.
MISTRAL_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GUAARDVARK_URL: Optional. Base URL of a local guaardvark instance, used by the
# LoRA Studio to dispatch training jobs to its Cast Studio (plugin lora_trainer).
# Its Flask backend listens on :5000 by default (:5055 on macOS).
GUAARDVARK_URL="http://127.0.0.1:5000"

# GUAARDVARK_API_KEY: Optional. Only needed when guaardvark has
# GUAARDVARK_API_KEY set — it is forwarded as the X-API-Key header.
GUAARDVARK_API_KEY=""

# GUAARDVARK_TIMEOUT_MS: Optional. Probe timeout for guaardvark calls.
GUAARDVARK_TIMEOUT_MS=8000

# GUAARDVARK_ALLOW_REMOTE: Optional. The LoRA bridge only relays to localhost/LAN
# hosts by default (it is a proxy, so this prevents SSRF). Set to "true" only if
# your guaardvark instance lives on a public host.
GUAARDVARK_ALLOW_REMOTE=""

# WANGP_LORAS_ROOT: Optional. Root of WanGP's (Wan2GP) loras/ directory. The LoRA
# Studio lists <root>/<model-family>/ and serves those .safetensors over HTTP so
# the URL can be pasted straight into WanGP's "Enter Lora URL" field.
WANGP_LORAS_ROOT=""
